// RosettaForge challenge specimen
// id:        sort-003
// title:     Merge Sort
// category:  sorting
// language:  lua
// variant:   idiomatic
// difficulty: medium
// verified:  false
// complexity: Time O(n log n), space O(n): recursive merge sort.

// Edge variant covers already-sorted and duplicates cases.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "function merge_sort(a)\\n    if #a <= 1 then return a end\\n    local mid = math.floor(#a / 2)\\n    local left = {}\\n    local right = {}\\n    for i = 1, mid do table.insert(left, a[i]) end\\n    for i = mid + 1, #a do table.insert(right, a[i]) end\\n    return merge(merge_sort(left), merge_sort(right))\\nend\\nfunction merge(left, right)\\n    local result = {}\\n    local i = 1\\n    local j = 1\\n    while i <= #left && j <= #right do\\n        if left[i] <= right[j then table.insert(result, left[i]); i = i + 1 else table.insert(result, right[j]); j = j + 1 end\\n    end\\n    while i <= #left do table.insert(result, left[i]); i = i + 1 end\\n    while j <= #right do table.insert(result, right[j]); j = j + 1 end\\n    return result\\nend"
}

fn merge(left: [int], right: [int]) -> [int] {
    let result: [int] = []
    var i = 0
    var j = 0
    while i < left.len {
        if j >= right.len { list_push(result, left[i]); i = i + 1; continue }
        if left[i] <= right[j] {
            list_push(result, left[i])
            i = i + 1
        } else {
            list_push(result, right[j])
            j = j + 1
        }
    }
    while j < right.len {
        list_push(result, right[j])
        j = j + 1
    }
    return result
}

fn merge_sort(values: [int]) -> [int] {
    if values.len <= 1 { return values }
    let mid = values.len / 2
    let left: [int] = []
    var i = 0
    while i < mid {
        list_push(left, values[i])
        i = i + 1
    }
    let right: [int] = []
    i = mid
    while i < values.len {
        list_push(right, values[i])
        i = i + 1
    }
    let sorted_left = merge_sort(left)
    let sorted_right = merge_sort(right)
    return merge(sorted_left, sorted_right)
}

fn main() -> int {
    var failures = 0
    // input: first after sort; expected: 1
    if merge_sort([3, 1, 2])[0] != 1 {
        print("FAIL first after sort expected 1 got " + str_of_i64(merge_sort([3, 1, 2])[0]))
        failures = failures + 1
    } else {
        print("PASS first after sort = 1")
    }
    // input: second after sort; expected: 2
    if merge_sort([3, 1, 2])[1] != 2 {
        print("FAIL second after sort expected 2 got " + str_of_i64(merge_sort([3, 1, 2])[1]))
        failures = failures + 1
    } else {
        print("PASS second after sort = 2")
    }
    // input: third after sort; expected: 3
    if merge_sort([3, 1, 2])[2] != 3 {
        print("FAIL third after sort expected 3 got " + str_of_i64(merge_sort([3, 1, 2])[2]))
        failures = failures + 1
    } else {
        print("PASS third after sort = 3")
    }
    // input: single element; expected: 1
    if merge_sort([1])[0] != 1 {
        print("FAIL single element expected 1 got " + str_of_i64(merge_sort([1])[0]))
        failures = failures + 1
    } else {
        print("PASS single element = 1")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
