// RosettaForge challenge specimen
// id:        sort-002
// title:     Insertion Sort
// category:  sorting
// language:  elixir
// variant:   edge-case
// difficulty: easy
// verified:  false
// complexity: Time O(n^2), space O(n): insertion sort building sorted prefix.

// Edge variant covers reverse-ish input, already-sorted, and duplicates.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "def insertion_sort([]), do: []\\ndef insertion_sort([x]), do: [x]\\ndef insertion_sort([h | t]), do: insert(h, insertion_sort(t))\\ndefp insert(x, []), do: [x]\\ndefp insert(x, [h | t]), do: if x <= h, do: [x, h | t], else: [h | insert(x, t)]"
}

fn insertion_sort(values: [int]) -> [int] {
    let result = values
    var i = 1
    while i < result.len {
        let key = result[i]
        var j = i - 1
        while j >= 0 && result[j] > key {
            result[j + 1] = result[j]
            j = j - 1
        }
        result[j + 1] = key
        i = i + 1
    }
    return result
}

fn main() -> int {
    var failures = 0
    // input: reverse-ish input min; expected: 1
    if insertion_sort([5, 3, 8, 1, 2])[0] != 1 {
        print("FAIL reverse-ish input min expected 1 got " + str_of_i64(insertion_sort([5, 3, 8, 1, 2])[0]))
        failures = failures + 1
    } else {
        print("PASS reverse-ish input min = 1")
    }
    // input: reverse-ish input max; expected: 8
    if insertion_sort([5, 3, 8, 1, 2])[4] != 8 {
        print("FAIL reverse-ish input max expected 8 got " + str_of_i64(insertion_sort([5, 3, 8, 1, 2])[4]))
        failures = failures + 1
    } else {
        print("PASS reverse-ish input max = 8")
    }
    // input: already sorted; expected: 2
    if insertion_sort([1, 2, 3])[1] != 2 {
        print("FAIL already sorted expected 2 got " + str_of_i64(insertion_sort([1, 2, 3])[1]))
        failures = failures + 1
    } else {
        print("PASS already sorted = 2")
    }
    // input: duplicates; expected: 1
    if insertion_sort([2, 2, 1])[0] != 1 {
        print("FAIL duplicates expected 1 got " + str_of_i64(insertion_sort([2, 2, 1])[0]))
        failures = failures + 1
    } else {
        print("PASS duplicates = 1")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
