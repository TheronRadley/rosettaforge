// RosettaForge challenge specimen
// id:        stk-002
// title:     Evaluate RPN Expression
// category:  stacks
// language:  go
// variant:   idiomatic
// difficulty: medium
// verified:  false
// complexity: Time O(n), space O(n): operand stack over space-separated tokens.

// Edge variant covers subtraction and multiplication-before-addition.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "// reference implementation: stack-based RPN evaluation"
}

fn eval_rpn(tokens: str) -> int {
    let storage: [int] = []
    var top = 0
    var i = 0
    while i < tokens.len {
        let ch = tokens.slice(i, 1).text
        if ch == " " { i = i + 1; continue }
        if ch == "+" {
            let y = storage[top - 1]
            let x = storage[top - 2]
            storage[top - 2] = x + y
            top = top - 1
            i = i + 1
        } else if ch == "*" {
            let y = storage[top - 1]
            let x = storage[top - 2]
            storage[top - 2] = x * y
            top = top - 1
            i = i + 1
        } else if ch == "-" {
            let y = storage[top - 1]
            let x = storage[top - 2]
            storage[top - 2] = x - y
            top = top - 1
            i = i + 1
        } else {
            var num = 0
            while i < tokens.len {
                let dch = tokens.slice(i, 1).text
                if dch == "0" { num = num * 10 }
                else if dch == "1" { num = num * 10 + 1 }
                else if dch == "2" { num = num * 10 + 2 }
                else if dch == "3" { num = num * 10 + 3 }
                else if dch == "4" { num = num * 10 + 4 }
                else if dch == "5" { num = num * 10 + 5 }
                else if dch == "6" { num = num * 10 + 6 }
                else if dch == "7" { num = num * 10 + 7 }
                else if dch == "8" { num = num * 10 + 8 }
                else if dch == "9" { num = num * 10 + 9 }
                else { break }
                i = i + 1
            }
            if top < storage.len {
                storage[top] = num
            } else {
                list_push(storage, num)
            }
            top = top + 1
        }
    }
    return storage[top - 1]
}

fn main() -> int {
    var failures = 0
    // input: 3 plus 4; expected: 7
    if eval_rpn("3 4 +") != 7 {
        print("FAIL 3 plus 4 expected 7 got " + str_of_i64(eval_rpn("3 4 +")))
        failures = failures + 1
    } else {
        print("PASS 3 plus 4 = 7")
    }
    // input: single number; expected: 5
    if eval_rpn("5") != 5 {
        print("FAIL single number expected 5 got " + str_of_i64(eval_rpn("5")))
        failures = failures + 1
    } else {
        print("PASS single number = 5")
    }
    // input: 2 times 3 plus 4; expected: 10
    if eval_rpn("2 3 * 4 +") != 10 {
        print("FAIL 2 times 3 plus 4 expected 10 got " + str_of_i64(eval_rpn("2 3 * 4 +")))
        failures = failures + 1
    } else {
        print("PASS 2 times 3 plus 4 = 10")
    }
    // input: (1 plus 2) times 3; expected: 9
    if eval_rpn("1 2 + 3 *") != 9 {
        print("FAIL (1 plus 2) times 3 expected 9 got " + str_of_i64(eval_rpn("1 2 + 3 *")))
        failures = failures + 1
    } else {
        print("PASS (1 plus 2) times 3 = 9")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
