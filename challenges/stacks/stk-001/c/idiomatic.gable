// RosettaForge challenge specimen
// id:        stk-001
// title:     Balanced Parentheses
// category:  stacks
// language:  c
// variant:   idiomatic
// difficulty: easy
// verified:  false
// complexity: Time O(n), space O(1): depth counter as stack substitute.

// Edge variant covers unclosed, wrong order, and three pairs.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "int balanced(const char *s) { int d = 0; for (; *s; ++s) { if (*s == '(') d++; else if (*s == ')') { if (d == 0) return 0; d--; } }; return d == 0; }"
}

fn balanced(parens: str) -> bool {
    var depth = 0
    var i = 0
    while i < parens.len {
        let c = parens.slice(i, 1).text
        if c == "(" {
            depth = depth + 1
        } else if c == ")" {
            if depth == 0 { return false }
            depth = depth - 1
        }
        i = i + 1
    }
    return depth == 0
}

fn main() -> int {
    var failures = 0
    // input: empty string; expected: true
    if balanced("") != true {
        print("FAIL empty string expected true got " + str_of_bool(balanced("")))
        failures = failures + 1
    } else {
        print("PASS empty string = true")
    }
    // input: one pair; expected: true
    if balanced("()") != true {
        print("FAIL one pair expected true got " + str_of_bool(balanced("()")))
        failures = failures + 1
    } else {
        print("PASS one pair = true")
    }
    // input: nested pairs; expected: true
    if balanced("(())") != true {
        print("FAIL nested pairs expected true got " + str_of_bool(balanced("(())")))
        failures = failures + 1
    } else {
        print("PASS nested pairs = true")
    }
    // input: two pairs; expected: true
    if balanced("()()") != true {
        print("FAIL two pairs expected true got " + str_of_bool(balanced("()()")))
        failures = failures + 1
    } else {
        print("PASS two pairs = true")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
