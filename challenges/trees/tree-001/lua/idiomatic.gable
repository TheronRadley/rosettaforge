// RosettaForge challenge specimen
// id:        tree-001
// title:     Maximum Depth of Binary Tree
// category:  trees
// language:  lua
// variant:   idiomatic
// difficulty: medium
// verified:  false
// complexity: Time O(n), space O(h): 1 + max(depth(left), depth(right)).

// Edge variant covers right chain, perfect tree, root-only.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "// reference implementation: recursive max depth from array heap layout"
}

fn tree_depth(values: [int], i: int) -> int {
    if i >= values.len { return 0 }
    if values[i] == -1 { return 0 }
    let l = tree_depth(values, 2 * i + 1)
    let r = tree_depth(values, 2 * i + 2)
    var m = l
    if r > l { m = r }
    return m + 1
}

fn main() -> int {
    var failures = 0
    // input: sample tree; expected: 3
    if tree_depth([3, 9, 20, -1, -1, 15, 7], 0) != 3 {
        print("FAIL sample tree expected 3 got " + str_of_i64(tree_depth([3, 9, 20, -1, -1, 15, 7], 0)))
        failures = failures + 1
    } else {
        print("PASS sample tree = 3")
    }
    // input: single node; expected: 1
    if tree_depth([1], 0) != 1 {
        print("FAIL single node expected 1 got " + str_of_i64(tree_depth([1], 0)))
        failures = failures + 1
    } else {
        print("PASS single node = 1")
    }
    // input: empty tree; expected: 0
    if tree_depth([], 0) != 0 {
        print("FAIL empty tree expected 0 got " + str_of_i64(tree_depth([], 0)))
        failures = failures + 1
    } else {
        print("PASS empty tree = 0")
    }
    // input: left chain; expected: 3
    if tree_depth([1, 2, -1, 3, -1, -1, -1], 0) != 3 {
        print("FAIL left chain expected 3 got " + str_of_i64(tree_depth([1, 2, -1, 3, -1, -1, -1], 0)))
        failures = failures + 1
    } else {
        print("PASS left chain = 3")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
