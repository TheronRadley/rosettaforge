// RosettaForge challenge specimen
// id:        str-003
// title:     Anagram Check
// category:  strings
// language:  julia
// variant:   edge-case
// difficulty: medium
// verified:  false
// complexity: Time O(n^2), space O(1): character-count comparison without extra memory.

// Edge variant adds explicit length check and different-lengths case.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "function are_anagrams(a, b)\\n    if length(a) != length(b) return false end\\n    return sort(collect(a)) == sort(collect(b))\\nend"
}

fn count_char(s: str, ch: str) -> int {
    var n = 0
    var i = 0
    while i < s.len {
        if s.slice(i, 1).text == ch { n = n + 1 }
        i = i + 1
    }
    return n
}

fn are_anagrams(a: str, b: str) -> bool {
    if a.len != b.len { return false }
    var i = 0
    while i < a.len {
        let ch = a.slice(i, 1).text
        if count_char(a, ch) != count_char(b, ch) { return false }
        i = i + 1
    }
    return true
}

fn main() -> int {
    var failures = 0
    // input: two-char anagram; expected: true
    if are_anagrams("ab", "ba") != true {
        print("FAIL two-char anagram expected true got " + str_of_bool(are_anagrams("ab", "ba")))
        failures = failures + 1
    } else {
        print("PASS two-char anagram = true")
    }
    // input: different chars; expected: false
    if are_anagrams("a", "b") != false {
        print("FAIL different chars expected false got " + str_of_bool(are_anagrams("a", "b")))
        failures = failures + 1
    } else {
        print("PASS different chars = false")
    }
    // input: different lengths; expected: false
    if are_anagrams("ab", "abc") != false {
        print("FAIL different lengths expected false got " + str_of_bool(are_anagrams("ab", "abc")))
        failures = failures + 1
    } else {
        print("PASS different lengths = false")
    }
    // input: classic anagram; expected: true
    if are_anagrams("listen", "silent") != true {
        print("FAIL classic anagram expected true got " + str_of_bool(are_anagrams("listen", "silent")))
        failures = failures + 1
    } else {
        print("PASS classic anagram = true")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
