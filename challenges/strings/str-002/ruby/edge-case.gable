// RosettaForge challenge specimen
// id:        str-002
// title:     Palindrome Check
// category:  strings
// language:  ruby
// variant:   edge-case
// difficulty: easy
// verified:  false
// complexity: Time O(n), space O(1): two-pointer comparison from both ends.

// Edge variant explicitly handles empty and single-character strings.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "def is_palindrome(s)\\n    return true if s.length <= 1\\n    s == s.reverse\\nend"
}

fn is_palindrome(s: str) -> bool {
    var i = 0
    var j = s.len - 1
    while i < j {
        if s.slice(i, 1).text != s.slice(j, 1).text { return false }
        i = i + 1
        j = j - 1
    }
    return true
}

fn main() -> int {
    var failures = 0
    // input: even-length palindrome; expected: true
    if is_palindrome("abba") != true {
        print("FAIL even-length palindrome expected true got " + str_of_bool(is_palindrome("abba")))
        failures = failures + 1
    } else {
        print("PASS even-length palindrome = true")
    }
    // input: odd-length palindrome; expected: true
    if is_palindrome("abcba") != true {
        print("FAIL odd-length palindrome expected true got " + str_of_bool(is_palindrome("abcba")))
        failures = failures + 1
    } else {
        print("PASS odd-length palindrome = true")
    }
    // input: two different chars; expected: false
    if is_palindrome("ab") != false {
        print("FAIL two different chars expected false got " + str_of_bool(is_palindrome("ab")))
        failures = failures + 1
    } else {
        print("PASS two different chars = false")
    }
    // input: another palindrome; expected: true
    if is_palindrome("madam") != true {
        print("FAIL another palindrome expected true got " + str_of_bool(is_palindrome("madam")))
        failures = failures + 1
    } else {
        print("PASS another palindrome = true")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
