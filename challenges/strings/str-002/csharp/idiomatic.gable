// RosettaForge challenge specimen
// id:        str-002
// title:     Palindrome Check
// category:  strings
// language:  csharp
// variant:   idiomatic
// difficulty: easy
// verified:  false
// complexity: Time O(n), space O(1): two-pointer comparison from both ends.

// Edge variant explicitly handles empty and single-character strings.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "public static bool IsPalindrome(string s) { for (int i = 0; i < s.Length / 2; i++) { if (s[i] != s[s.Length - 1 - i]) return false; }; return true; }"
}

fn is_palindrome(s: str) -> bool {
    var i = 0
    var j = s.len - 1
    while i < j {
        if s.slice(i, 1).text != s.slice(j, 1).text { return false }
        i = i + 1
        j = j - 1
    }
    return true
}

fn main() -> int {
    var failures = 0
    // input: palindrome word; expected: true
    if is_palindrome("racecar") != true {
        print("FAIL palindrome word expected true got " + str_of_bool(is_palindrome("racecar")))
        failures = failures + 1
    } else {
        print("PASS palindrome word = true")
    }
    // input: not palindrome; expected: false
    if is_palindrome("hello") != false {
        print("FAIL not palindrome expected false got " + str_of_bool(is_palindrome("hello")))
        failures = failures + 1
    } else {
        print("PASS not palindrome = false")
    }
    // input: empty string; expected: true
    if is_palindrome("") != true {
        print("FAIL empty string expected true got " + str_of_bool(is_palindrome("")))
        failures = failures + 1
    } else {
        print("PASS empty string = true")
    }
    // input: single char; expected: true
    if is_palindrome("a") != true {
        print("FAIL single char expected true got " + str_of_bool(is_palindrome("a")))
        failures = failures + 1
    } else {
        print("PASS single char = true")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
