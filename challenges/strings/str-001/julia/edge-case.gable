// RosettaForge challenge specimen
// id:        str-001
// title:     Count words in a text
// category:  strings
// language:  julia
// variant:   edge-case
// difficulty: easy
// verified:  false
// complexity: Time O(n), space O(n): split on single spaces, count non-empty pieces.

// Reference snippet (julia, edge-case):
//   function wordCount(text)
//       if isempty(strip(text)) return 0 end
//       n, inWord = 0, false
//       for ch in text
//           if isspace(ch)
//               inWord = false
//           elseif !inWord
//               inWord = true; n += 1
//           end
//       end
//       return n
//   end

// Edge variant covers spaces-only input, no separators, and leading/trailing spaces (empty pieces are skipped).
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "function wordCount(text)\n    if isempty(strip(text)) return 0 end\n    n, inWord = 0, false\n    for ch in text\n        if isspace(ch)\n            inWord = false\n        elseif !inWord\n            inWord = true; n += 1\n        end\n    end\n    return n\nend"
}

fn word_count(text: str) -> int {
    let parts = text.split(" ")
    var n = 0
    for p in parts {
        if p != "" { n = n + 1 }
    }
    return n
}

fn main() -> int {
    var failures = 0
    // input: spaces only; expected: 0
    if word_count("   ") != 0 {
        print("FAIL spaces only expected 0 got " + str_of_i64(word_count("   ")))
        failures = failures + 1
    } else {
        print("PASS spaces only = 0")
    }
    // input: no separator; expected: 1
    if word_count("hello") != 1 {
        print("FAIL no separator expected 1 got " + str_of_i64(word_count("hello")))
        failures = failures + 1
    } else {
        print("PASS no separator = 1")
    }
    // input: leading and trailing spaces; expected: 2
    if word_count(" leading trailing ") != 2 {
        print("FAIL leading and trailing spaces expected 2 got " + str_of_i64(word_count(" leading trailing ")))
        failures = failures + 1
    } else {
        print("PASS leading and trailing spaces = 2")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
