// RosettaForge challenge specimen
// id:        seq-002
// title:     Linear Search
// category:  sequences
// language:  haskell
// variant:   idiomatic
// difficulty: easy
// verified:  false
// complexity: Time O(n), space O(1): single pass scan.

// Edge variant covers empty list and single-element edge cases.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "linearSearch values target = case findIndex (== target) values of Just i -> i; Nothing -> -1"
}

fn linear_search(values: [int], target: int) -> int {
    var i = 0
    while i < values.len {
        if values[i] == target { return i }
        i = i + 1
    }
    return -1
}

fn main() -> int {
    var failures = 0
    // input: middle element; expected: 2
    if linear_search([1, 2, 3, 4, 5], 3) != 2 {
        print("FAIL middle element expected 2 got " + str_of_i64(linear_search([1, 2, 3, 4, 5], 3)))
        failures = failures + 1
    } else {
        print("PASS middle element = 2")
    }
    // input: first element; expected: 0
    if linear_search([1, 2, 3], 1) != 0 {
        print("FAIL first element expected 0 got " + str_of_i64(linear_search([1, 2, 3], 1)))
        failures = failures + 1
    } else {
        print("PASS first element = 0")
    }
    // input: last element; expected: 2
    if linear_search([1, 2, 3], 3) != 2 {
        print("FAIL last element expected 2 got " + str_of_i64(linear_search([1, 2, 3], 3)))
        failures = failures + 1
    } else {
        print("PASS last element = 2")
    }
    // input: second element; expected: 1
    if linear_search([10, 20, 30], 20) != 1 {
        print("FAIL second element expected 1 got " + str_of_i64(linear_search([10, 20, 30], 20)))
        failures = failures + 1
    } else {
        print("PASS second element = 1")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
