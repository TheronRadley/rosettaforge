// RosettaForge challenge specimen
// id:        seq-003
// title:     Binary Search
// category:  sequences
// language:  dart
// variant:   edge-case
// difficulty: medium
// verified:  false
// complexity: Time O(log n), space O(1): binary search on sorted list.

// Edge variant covers empty list and single-element edge cases.
// Gable implementation and executable self-test below.

fn reference_snippet() -> str {
    return "int binarySearch(List<int> values, int target) { if (values.isEmpty) return -1; var lo = 0; var hi = values.length - 1; while (lo <= hi) { var mid = (lo + hi) ~/ 2; if (values[mid] == target) return mid; if (values[mid] < target) lo = mid + 1; else hi = mid - 1; }; return -1; }"
}

fn binary_search(values: [int], target: int) -> int {
    var lo = 0
    var hi = values.len - 1
    while lo <= hi {
        let mid = (lo + hi) / 2
        if values[mid] == target { return mid }
        if values[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}

fn main() -> int {
    var failures = 0
    // input: not found; expected: -1
    if binary_search([1, 2, 3], 4) != -1 {
        print("FAIL not found expected -1 got " + str_of_i64(binary_search([1, 2, 3], 4)))
        failures = failures + 1
    } else {
        print("PASS not found = -1")
    }
    // input: empty list; expected: -1
    if binary_search([], 1) != -1 {
        print("FAIL empty list expected -1 got " + str_of_i64(binary_search([], 1)))
        failures = failures + 1
    } else {
        print("PASS empty list = -1")
    }
    // input: single match; expected: 0
    if binary_search([5], 5) != 0 {
        print("FAIL single match expected 0 got " + str_of_i64(binary_search([5], 5)))
        failures = failures + 1
    } else {
        print("PASS single match = 0")
    }
    // input: single no match; expected: -1
    if binary_search([5], 3) != -1 {
        print("FAIL single no match expected -1 got " + str_of_i64(binary_search([5], 3)))
        failures = failures + 1
    } else {
        print("PASS single no match = -1")
    }
    print("failures: " + str_of_i64(failures))
    return failures
}
