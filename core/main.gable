fn filter_difficulty(dif: str) -> int {
    var total = 0
    total = total + print_difficulty(catalog_000(), dif)
    total = total + print_difficulty(catalog_001(), dif)
    total = total + print_difficulty(catalog_002(), dif)
    total = total + print_difficulty(catalog_003(), dif)
    total = total + print_difficulty(catalog_004(), dif)
    total = total + print_difficulty(catalog_005(), dif)
    total = total + print_difficulty(catalog_006(), dif)
    total = total + print_difficulty(catalog_007(), dif)
    print("---")
    print("matches: " + str_of_i64(total))
    return 0
}

fn view_specimen(id: str) -> int {
    let hit_catalog000 = find_entry(catalog_000(), id)
    if hit_catalog000.ok {
        print_entry_full(hit_catalog000.entry)
        return 0
    }
    let hit_catalog001 = find_entry(catalog_001(), id)
    if hit_catalog001.ok {
        print_entry_full(hit_catalog001.entry)
        return 0
    }
    let hit_catalog002 = find_entry(catalog_002(), id)
    if hit_catalog002.ok {
        print_entry_full(hit_catalog002.entry)
        return 0
    }
    let hit_catalog003 = find_entry(catalog_003(), id)
    if hit_catalog003.ok {
        print_entry_full(hit_catalog003.entry)
        return 0
    }
    let hit_catalog004 = find_entry(catalog_004(), id)
    if hit_catalog004.ok {
        print_entry_full(hit_catalog004.entry)
        return 0
    }
    let hit_catalog005 = find_entry(catalog_005(), id)
    if hit_catalog005.ok {
        print_entry_full(hit_catalog005.entry)
        return 0
    }
    let hit_catalog006 = find_entry(catalog_006(), id)
    if hit_catalog006.ok {
        print_entry_full(hit_catalog006.entry)
        return 0
    }
    let hit_catalog007 = find_entry(catalog_007(), id)
    if hit_catalog007.ok {
        print_entry_full(hit_catalog007.entry)
        return 0
    }
    print("specimen not found: " + id)
    return 1
}

fn check_command(id: str) -> int {
    let hit_catalog000 = find_entry(catalog_000(), id)
    if hit_catalog000.ok {
        print("gable check " + hit_catalog000.entry.path)
        return 0
    }
    let hit_catalog001 = find_entry(catalog_001(), id)
    if hit_catalog001.ok {
        print("gable check " + hit_catalog001.entry.path)
        return 0
    }
    let hit_catalog002 = find_entry(catalog_002(), id)
    if hit_catalog002.ok {
        print("gable check " + hit_catalog002.entry.path)
        return 0
    }
    let hit_catalog003 = find_entry(catalog_003(), id)
    if hit_catalog003.ok {
        print("gable check " + hit_catalog003.entry.path)
        return 0
    }
    let hit_catalog004 = find_entry(catalog_004(), id)
    if hit_catalog004.ok {
        print("gable check " + hit_catalog004.entry.path)
        return 0
    }
    let hit_catalog005 = find_entry(catalog_005(), id)
    if hit_catalog005.ok {
        print("gable check " + hit_catalog005.entry.path)
        return 0
    }
    let hit_catalog006 = find_entry(catalog_006(), id)
    if hit_catalog006.ok {
        print("gable check " + hit_catalog006.entry.path)
        return 0
    }
    let hit_catalog007 = find_entry(catalog_007(), id)
    if hit_catalog007.ok {
        print("gable check " + hit_catalog007.entry.path)
        return 0
    }
    print("specimen not found: " + id)
    return 1
}

fn run_command(id: str) -> int {
    let hit_catalog000 = find_entry(catalog_000(), id)
    if hit_catalog000.ok {
        print("gable run " + hit_catalog000.entry.path)
        return 0
    }
    let hit_catalog001 = find_entry(catalog_001(), id)
    if hit_catalog001.ok {
        print("gable run " + hit_catalog001.entry.path)
        return 0
    }
    let hit_catalog002 = find_entry(catalog_002(), id)
    if hit_catalog002.ok {
        print("gable run " + hit_catalog002.entry.path)
        return 0
    }
    let hit_catalog003 = find_entry(catalog_003(), id)
    if hit_catalog003.ok {
        print("gable run " + hit_catalog003.entry.path)
        return 0
    }
    let hit_catalog004 = find_entry(catalog_004(), id)
    if hit_catalog004.ok {
        print("gable run " + hit_catalog004.entry.path)
        return 0
    }
    let hit_catalog005 = find_entry(catalog_005(), id)
    if hit_catalog005.ok {
        print("gable run " + hit_catalog005.entry.path)
        return 0
    }
    let hit_catalog006 = find_entry(catalog_006(), id)
    if hit_catalog006.ok {
        print("gable run " + hit_catalog006.entry.path)
        return 0
    }
    let hit_catalog007 = find_entry(catalog_007(), id)
    if hit_catalog007.ok {
        print("gable run " + hit_catalog007.entry.path)
        return 0
    }
    print("specimen not found: " + id)
    return 1
}

fn show_stats() -> int {
    var total = 0
    total = total + count_all(catalog_000())
    total = total + count_all(catalog_001())
    total = total + count_all(catalog_002())
    total = total + count_all(catalog_003())
    total = total + count_all(catalog_004())
    total = total + count_all(catalog_005())
    total = total + count_all(catalog_006())
    total = total + count_all(catalog_007())
    print("specimens indexed: " + str_of_i64(total))
    print("index shards: 8")
    return 0
}

fn main() -> int {
    let cmd = arg_or_empty(1)
    if cmd == "" {
        print_help()
        return 0
    }
    if cmd == "catalog" {
        return list_catalog()
    }
    if cmd == "search" {
        return search_catalog(arg_or_empty(2))
    }
    if cmd == "category" {
        return filter_category(arg_or_empty(2))
    }
    if cmd == "language" {
        return filter_language(arg_or_empty(2))
    }
    if cmd == "difficulty" {
        return filter_difficulty(arg_or_empty(2))
    }
    if cmd == "view" {
        return view_specimen(arg_or_empty(2))
    }
    if cmd == "check" {
        return check_command(arg_or_empty(2))
    }
    if cmd == "run" {
        return run_command(arg_or_empty(2))
    }
    if cmd == "stats" {
        return show_stats()
    }
    print("unknown command: " + cmd)
    print_help()
    return 1
}
