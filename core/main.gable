// RosettaForge core — command-line interface
// ==========================================
//
// Entry point of the RosettaForge CLI. Imports only catalog helpers and
// index shards (metadata) — never challenge specimens, so the import graph
// stays far below the compiler limits (512 files, depth 64).
//
// Gable cannot spawn child processes, so check/run commands print the exact
// command to execute; copy and run it directly.
//
// Usage:
//   gable run core/main.gable                 show this help
//   gable run core/main.gable -- catalog      list all specimens
//   gable run core/main.gable -- search <kw>  search specimens by keyword
//   gable run core/main.gable -- category <cat>  filter specimens by category
//   gable run core/main.gable -- language <lang>  filter specimens by language
//   gable run core/main.gable -- difficulty <d>  filter specimens by difficulty
//   gable run core/main.gable -- view <id>    show specimen metadata
//   gable run core/main.gable -- check <id>   print the `gable check` command
//   gable run core/main.gable -- run <id>     print the `gable run` command
//   gable run core/main.gable -- stats        catalog statistics
// Program arguments follow `--` and are read with arg_count()/arg(i).

import "../core/catalog.gable"
import "../index/catalog_000.gable"
import "../index/catalog_001.gable"
import "../index/catalog_002.gable"
import "../index/catalog_003.gable"
import "../index/catalog_004.gable"
import "../index/catalog_005.gable"
import "../index/catalog_006.gable"
import "../index/catalog_007.gable"
// Each index shard exposes its entries through a uniquely-named function
// (catalog_000_entries, catalog_001_entries, ...). Gable resolves functions
// program-wide across imported files, so no forward declaration is needed.

fn print_help() {
    print("RosettaForge CLI — usage:")
    print("  gable run core/main.gable                 show this help")
    print("  gable run core/main.gable -- catalog      list all specimens")
    print("  gable run core/main.gable -- search <kw>  search specimens by keyword")
    print("  gable run core/main.gable -- category <cat>  filter specimens by category")
    print("  gable run core/main.gable -- language <lang>  filter specimens by language")
    print("  gable run core/main.gable -- difficulty <d>  filter specimens by difficulty")
    print("  gable run core/main.gable -- view <id>        show specimen metadata")
    print("  gable run core/main.gable -- check <id>   print the `gable check` command")
    print("  gable run core/main.gable -- run <id>     print the `gable run` command")
    print("  gable run core/main.gable -- stats        catalog statistics")
}

fn arg_or_empty(index: int) -> str {
    if arg_count() > index {
        return arg(index)
    }
    return ""
}

fn list_catalog() -> int {
    var total = 0
    for e in catalog_000() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_001() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_002() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_003() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_004() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_005() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_006() {
        print_entry(e)
        total = total + 1
    }
    for e in catalog_007() {
        print_entry(e)
        total = total + 1
    }
    print("---")
    print("total specimens: " + str_of_i64(total))
    return 0
}

fn search_catalog(keyword: str) -> int {
    var total = 0
    total = total + print_matches(catalog_000(), keyword)
    total = total + print_matches(catalog_001(), keyword)
    total = total + print_matches(catalog_002(), keyword)
    total = total + print_matches(catalog_003(), keyword)
    total = total + print_matches(catalog_004(), keyword)
    total = total + print_matches(catalog_005(), keyword)
    total = total + print_matches(catalog_006(), keyword)
    total = total + print_matches(catalog_007(), keyword)
    print("---")
    print("matches: " + str_of_i64(total))
    return 0
}

fn filter_category(cat: str) -> int {
    var total = 0
    total = total + print_category(catalog_000(), cat)
    total = total + print_category(catalog_001(), cat)
    total = total + print_category(catalog_002(), cat)
    total = total + print_category(catalog_003(), cat)
    total = total + print_category(catalog_004(), cat)
    total = total + print_category(catalog_005(), cat)
    total = total + print_category(catalog_006(), cat)
    total = total + print_category(catalog_007(), cat)
    print("---")
    print("matches: " + str_of_i64(total))
    return 0
}

